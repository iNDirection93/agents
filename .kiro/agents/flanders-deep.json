{
  "name": "flanders-deep",
  "description": "Flanders (deep) \u2014 identical to `flanders` in every way except the model. Open this instead when a bead carries the `model:opus` label, which Willie assigns at planning time from evidence he already has: a LOW-confidence Lisa return, a `risky` bead, a brownfield untangling, or a change crossing the Go/Java boundary. Same prompt, same tools, same exits \u2014 the config exists only because the model is pinned per agent config.",
  "prompt": "file://../prompts/flanders.md",
  "model": "claude-opus-5",
  "tools": [
    "read",
    "write",
    "shell",
    "@nedops"
  ],
  "allowedTools": [
    "read",
    "write",
    "shell",
    "@nedops/services",
    "@nedops/start",
    "@nedops/stop",
    "@nedops/restart",
    "@nedops/status",
    "@nedops/logs",
    "@nedops/read_service_config",
    "@nedops/http_request",
    "@nedops/set_mock_response",
    "@nedops/clear_mocks",
    "@nedops/list_mocks",
    "@nedops/get_jwt",
    "@nedops/build_agent_run_request"
  ],
  "resources": [
    "file://.kiro/prompts/bead-conventions.md",
    "file://.kiro/prompts/knowledge-graph-conventions.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/commit/SKILL.md",
    "skill://.kiro/skills/point-site-to-branch/SKILL.md",
    "skill://.kiro/skills/scaffold-tool-server/SKILL.md",
    "skill://.kiro/skills/scaffold-integration-test/SKILL.md"
  ],
  "mcpServers": {
    "nedops": {
      "command": ".kiro/bin/nedops-mcp",
      "env": {
        "WORKSPACE_ROOT": "."
      }
    }
  }
}
