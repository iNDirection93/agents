{
  "name": "willie",
  "description": "Willie \u2014 PR Planning Agent. Investigates before planning, decomposes into beads, and allocates every change to an owning package against the nesting rule. Consumes and deletes Dr. Nick's implementation guides; handles SURVEY beads and Bart's harvest corrections.",
  "prompt": "file://../prompts/willie.md",
  "model": "claude-opus-5",
  "tools": [
    "read",
    "write",
    "shell",
    "subagent",
    "@willie-audit"
  ],
  "allowedTools": [
    "read",
    "write",
    "shell",
    "subagent",
    "@willie-audit"
  ],
  "toolsSettings": {
    "subagent": {
      "availableAgents": [
        "lisa"
      ],
      "trustedAgents": [
        "lisa"
      ],
      "agentPermissions": {
        "lisa": {
          "allowedTools": [
            "read",
            "shell"
          ]
        }
      }
    }
  },
  "mcpServers": {
    "willie-audit": {
      "command": ".kiro/bin/willie-audit-mcp",
      "env": {
        "WORKSPACE_ROOT": "."
      }
    }
  },
  "resources": [
    "file://.kiro/prompts/bead-conventions.md",
    "file://.kiro/prompts/knowledge-graph-conventions.md",
    "file://.kiro/steering/**/*.md"
  ]
}
